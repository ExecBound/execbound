# Reference only. Run `uv run python scripts/local_setup.py` to create .env once.
# Do not copy these placeholders as working credentials.
# Native alternative: add --postgres-bin <the directory holding PostgreSQL 17's initdb and pg_ctl>
POSTGRES_PASSWORD=REPLACE_WITH_A_RANDOM_OWNER_PASSWORD
EXECBOUND_APP_PASSWORD=REPLACE_WITH_A_DIFFERENT_RANDOM_RUNTIME_PASSWORD
DATABASE_URL=postgresql+psycopg://execbound_app:REPLACE_WITH_A_DIFFERENT_RANDOM_RUNTIME_PASSWORD@127.0.0.1:55439/execbound
MIGRATION_DATABASE_URL=postgresql+psycopg://execbound_owner:REPLACE_WITH_A_RANDOM_OWNER_PASSWORD@127.0.0.1:55439/execbound
TEST_DATABASE_URL=postgresql+psycopg://execbound_app:REPLACE_WITH_A_DIFFERENT_RANDOM_RUNTIME_PASSWORD@127.0.0.1:55439/execbound_test
TEST_MIGRATION_DATABASE_URL=postgresql+psycopg://execbound_owner:REPLACE_WITH_A_RANDOM_OWNER_PASSWORD@127.0.0.1:55439/execbound_test
