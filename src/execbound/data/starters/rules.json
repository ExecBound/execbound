  "isolate-workstation-open-critical": {
    "id": "isolate-workstation-open-critical",
    "action": "endpoint.isolate",
    "effect": "ALLOW",
    "when": [
      {
        "kind": "fact",
        "name": "role",
        "operator": "is",
        "values": [
          "workstation"
        ]
      },
      {
        "kind": "fact",
        "name": "incident_status",
        "operator": "is",
        "values": [
          "OPEN"
        ]
      },
      {
        "kind": "fact",
        "name": "incident_severity",
        "operator": "is",
        "values": [
          "CRITICAL"
        ]
      }
    ],
    "quorum": null,
    "note": null
  },
