          "execution_id": "=DEFAULT(execute.body.execution_id, null)",
          "message": "Stop. Hand this execution to an ExecBound administrator; never resend under a new reference and never repeat the vendor call.",
          "outcome": "needs_administrator",
          "path": "gate",
