    {
      "description": null,
      "disabled": false,
      "guid": "0514293c26a5181f5e6acc4ba156796c",
      "monitoring": null,
      "name": "Outcome",
      "options": {
        "mode": "message_only",
        "payload": {
          "approval_state": "=DEFAULT(execute.body.approval_state, null)",
          "approval_url": "=DEFAULT(execute.body.approval_url, null)",
          "code": "=IF(IS_PRESENT(report.status), IF(report.body.state = \"INDETERMINATE\", \"VENDOR_OUTCOME_UNKNOWN\", DEFAULT(report.body.code, null)), DEFAULT(execute.body.code, null))",
          "execution_id": "=DEFAULT(execute.body.execution_id, null)",
          "message": "=IF(IS_PRESENT(report.status), IF(report.body.state = \"INDETERMINATE\", \"Stop. Hand this execution to an ExecBound administrator; never resend under a new reference and never repeat the vendor call.\", IF(IS_PRESENT(vendor_call.status), \"The vendor was called once and ExecBound settled the report.\", \"The vendor was not called: the act window had closed, and ExecBound settled the signed non-execution.\")), SWITCH(DEFAULT(execute.body.state, \"\"), \"EXECUTED\", \"This reference already has a recorded result; this run did not call the vendor.\", \"FAILED_NOT_EXECUTED\", \"This reference already has a recorded result; this run did not call the vendor.\", \"FAILED_EFFECT_UNKNOWN\", \"This reference already has a recorded result; this run did not call the vendor.\", \"The vendor was not called.\"))",
          "outcome": "=IF(IS_PRESENT(report.status), IF(report.body.state = \"INDETERMINATE\", \"needs_administrator\", \"final\"), IF(DEFAULT(execute.status, 0) >= 500, \"uncertain\", SWITCH(DEFAULT(execute.body.state, \"\"), \"PENDING_APPROVAL\", \"pending\", \"STALE_AUTHORIZATION\", \"expired\", \"INDETERMINATE\", \"uncertain\", \"DENIED\", \"final\", \"OBSERVED\", \"final\", \"EXECUTED\", \"final\", \"FAILED_NOT_EXECUTED\", \"final\", \"FAILED_EFFECT_UNKNOWN\", \"uncertain\", \"refused\")))",
          "path": "gate",
          "reference": "=prepare.reference",
          "request_ref": "=DEFAULT(execute.body.request_ref, null)",
          "state": "=DEFAULT(report.body.state, DEFAULT(execute.body.state, null))",
          "tier": "=IF(DEFAULT(report.status, 0) = 200, IF(OR(IS_PRESENT(report_journal.body), IS_PRESENT(report_lookup.body)), \"PROVIDER_VERIFIED\", IF(IS_PRESENT(report_attestation.body), \"ATTESTED\", null)), null)",
          "vendor_status": "=DEFAULT(vendor_call.status, null)"
        }
      },
      "origin_story_identifier": "cloud:execbound:gate",
      "reporting": null,
      "template": null,
      "type": "Agents::EventTransformationAgent",
