      "width": null
    },
    {
      "description": "Defaults and normalisation. No idempotency key is derived here: the gateway derives it from the reference, so this story and the Python client land on the same intent.",
      "disabled": false,
      "guid": "2a2118527fb6402037faadedef31b378",
      "monitoring": {
        "monitor_all_events": false,
        "monitor_failures": false,
        "monitor_no_events_emitted": null
      },
      "name": "Prepare",
      "options": {
        "mode": "message_only",
        "payload": {
          "arguments": "=DEFAULT(DEFAULT(entry.body.arguments, entry.arguments), JSON_PARSE(\"{}\"))",
          "attempt": 0,
          "incident_id": "=DEFAULT(entry.body.incident_id, entry.incident_id)",
          "operation_ref": "=DEFAULT(DEFAULT(entry.body.operation_ref, entry.operation_ref), \"endpoint.isolate\")",
          "reference": "=STRIP(DEFAULT(entry.body.reference, entry.reference))",
          "started_at": "=NOW()",
          "target_kind": "=DEFAULT(DEFAULT(entry.body.target_kind, entry.target_kind), \"hostname\")",
          "target_value": "=SWITCH(DEFAULT(DEFAULT(entry.body.target_kind, entry.target_kind), \"hostname\"), \"hostname\", DOWNCASE(STRIP(DEFAULT(entry.body.target_value, entry.target_value))), STRIP(DEFAULT(entry.body.target_value, entry.target_value)))",
          "wait_seconds": "=DEFAULT(DEFAULT(entry.body.wait_seconds, entry.wait_seconds), RESOURCE.execbound_wait_seconds)",
          "external_case": "=DEFAULT(DEFAULT(entry.body.external_case, entry.external_case), null)"
        }
      },
