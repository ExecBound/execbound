    {
      "description": "One POST /v1/execute. The same reference on every re-send, so the gateway sees one intent and a decision already recorded is progressed rather than duplicated.",
      "disabled": false,
      "guid": "59143a5b43ba9e31a7e6e2585c98f944",
      "monitoring": {
        "monitor_all_events": false,
        "monitor_failures": false,
        "monitor_no_events_emitted": null
      },
      "name": "Execute",
      "options": {
        "disable_redirect_follow": true,
        "fail_on_status": false,
        "headers": {
          "Authorization": "Bearer <<CREDENTIAL.execbound>>",
          "Content-Type": "application/json"
        },
        "log_error_on_status": [
          400,
          401,
          403,
          404,
          409,
          422,
          423,
          500,
          503
        ],
        "method": "post",
        "payload": "=TO_JSON(OBJECT(\"arguments\", prepare.arguments, \"claimed_context\", OBJECT(\"incident_id\", prepare.incident_id), \"operation_ref\", prepare.operation_ref, \"reference\", prepare.reference, \"target\", OBJECT(\"kind\", prepare.target_kind, \"value\", prepare.target_value), \"external_case\", prepare.external_case))",
        "retries": 5,
        "retry_on_status": [
          429
        ],
        "url": "<<RESOURCE.execbound_origin>>/v1/execute"
      },
      "origin_story_identifier": null,
      "reporting": {
        "time_saved_unit": "minutes",
        "time_saved_value": 0
      },
      "schedule": null,
      "template": {
        "created_from_template_guid": null,
        "created_from_template_version": null,
        "template_tags": []
      },
      "type": "Agents::HTTPRequestAgent",
      "width": null
    },
