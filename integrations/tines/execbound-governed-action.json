    {
      "description": "The exit action. Same shape as the Python client's summarize, so a team's downstream logic is the same whichever caller they use.",
      "disabled": false,
      "guid": "ed71df3db320e7bf46eee77975f58f02",
      "monitoring": {
        "monitor_all_events": false,
        "monitor_failures": false,
        "monitor_no_events_emitted": null
      },
      "name": "Outcome",
      "options": {
        "mode": "message_only",
        "payload": {
          "approval_state": "=DEFAULT(execute.body.approval_state, null)",
          "approval_url": "=DEFAULT(execute.body.approval_url, null)",
          "attempts": "=DEFAULT(next_attempt.attempt, prepare.attempt)",
          "code": "=DEFAULT(execute.body.code, DEFAULT(execute.body.detail, IF(AND(DEFAULT(execute.status, 0) >= 500, DEFAULT(execute.status, 0) <= 599), \"HTTP_RESPONSE_UNCERTAIN\", IF(IS_PRESENT(execute.retries_exhausted), \"RETRIES_EXHAUSTED\", SWITCH(JOIN([execute.status], \"\"), \"0\", \"TRANSPORT_UNCERTAIN\", null)))))",
          "execution_id": "=DEFAULT(execute.body.execution_id, null)",
          "idempotency_key": "=DEFAULT(execute.body.idempotency_key, null)",
          "message": "=SWITCH(IF(AND(DEFAULT(execute.status, 0) >= 500, DEFAULT(execute.status, 0) <= 599), \"uncertain\", SWITCH(DEFAULT(execute.body.state, JOIN([\"HTTP\", execute.status], \"-\")), \"EXECUTED\", \"final\", \"DENIED\", \"final\", \"FAILED_NOT_EXECUTED\", \"final\", \"OBSERVED\", \"final\", \"STALE_AUTHORIZATION\", \"expired\", \"PENDING_APPROVAL\", \"pending\", \"DISPATCH_COMMITTED\", \"uncertain\", \"INDETERMINATE\", \"uncertain\", \"FAILED_EFFECT_UNKNOWN\", \"uncertain\", \"HTTP-503\", \"uncertain\", \"HTTP-0\", \"uncertain\", \"HTTP-\", \"uncertain\", \"refused\")), \"uncertain\", \"Hand to an administrator. Never resend under a new key.\", \"pending\", \"A person must decide in the ExecBound console. To check again, call again with the same reference, never a new one.\", \"expired\", \"The approval deadline passed; the authorization is stale.\", \"refused\", \"The gateway refused this request; read code.\", \"The action reached a terminal state.\")",
          "outcome": "=IF(AND(DEFAULT(execute.status, 0) >= 500, DEFAULT(execute.status, 0) <= 599), \"uncertain\", SWITCH(DEFAULT(execute.body.state, JOIN([\"HTTP\", execute.status], \"-\")), \"EXECUTED\", \"final\", \"DENIED\", \"final\", \"FAILED_NOT_EXECUTED\", \"final\", \"OBSERVED\", \"final\", \"STALE_AUTHORIZATION\", \"expired\", \"PENDING_APPROVAL\", \"pending\", \"DISPATCH_COMMITTED\", \"uncertain\", \"INDETERMINATE\", \"uncertain\", \"FAILED_EFFECT_UNKNOWN\", \"uncertain\", \"HTTP-503\", \"uncertain\", \"HTTP-0\", \"uncertain\", \"HTTP-\", \"uncertain\", \"refused\"))",
          "reference": "=prepare.reference",
          "state": "=DEFAULT(execute.body.state, null)",
          "request_ref": "=DEFAULT(execute.body.request_ref, null)"
        }
      },
      "origin_story_identifier": null,
      "reporting": {
        "time_saved_unit": "minutes",
        "time_saved_value": 0
      },
