          "arguments": "=JSON_PARSE(\"{}\")",
          "incident_id": "=DEFAULT(triage_agent.output.incident_id, triage_agent.output.incident)",
          "operation_ref": "=SWITCH(DEFAULT(triage_agent.output.operation_ref, \"endpoint.isolate\"), \"isolate_endpoint\", \"endpoint.isolate\", \"isolate\", \"endpoint.isolate\", \"endpoint_isolate\", \"endpoint.isolate\", \"disable_user\", \"identity.disable\", DEFAULT(triage_agent.output.operation_ref, \"endpoint.isolate\"))",
