      "name": "Triage agent",
      "options": {
        "code_analyst_enabled": false,
        "instructions": "You are a SOC triage analyst. You are given one alert. Decide whether a consequential action is warranted and, if so, which one. You do NOT perform the action yourself: ExecBound authorizes it, and when a person is required they decide in the ExecBound console. Rules you must follow: use only the six operation_ref values offered; copy the hostname, incident id and ticket id exactly as given and never invent one; if you are not confident an action is warranted, set should_act to false and explain why.",
        "mode": "task",
        "output_schema": {
          "properties": {
            "incident_id": {
              "description": "the incident uuid given in the alert, verbatim",
              "type": "string"
            },
            "operation_ref": {
              "enum": [
                "endpoint.isolate",
                "endpoint.lift_isolation",
                "identity.disable",
                "identity.enable",
                "identity.revoke_sessions",
                "identity.reset_password"
              ],
              "type": "string"
            },
            "reasoning": {
              "type": "string"
            },
            "reference": {
              "description": "the ticket id given in the alert, verbatim",
              "type": "string"
            },
            "should_act": {
              "type": "boolean"
            },
            "target_kind": {
              "enum": [
                "hostname",
                "provider_id",
                "canonical"
              ],
              "type": "string"
            },
            "target_value": {
              "type": "string"
            }
          },
          "required": [
            "should_act",
            "reasoning"
          ],
          "type": "object"
        },
        "prompt": "Alert:\n\n<<alert>>\n\nDecide. Answer with ONLY a JSON object using EXACTLY these field names and no others:\n{\"should_act\": true, \"operation_ref\": \"endpoint.isolate\", \"target_kind\": \"hostname\", \"target_value\": \"workstation-01\", \"reference\": \"INC-2001\", \"incident_id\": \"11111111-1111-4111-8111-111111111111\", \"reasoning\": \"why\"}\noperation_ref must be one of: endpoint.isolate, endpoint.lift_isolation, identity.disable, identity.enable, identity.revoke_sessions, identity.reset_password. reference is the ticket id from the alert, copied verbatim. incident_id is the incident uuid from the alert, copied verbatim.",
        "web_search_enabled": false
      },
      "origin_story_identifier": null,
