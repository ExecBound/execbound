          "target_kind": "=DEFAULT(triage_agent.output.target_kind, \"hostname\")",
          "target_value": "=DEFAULT(triage_agent.output.target_value, DEFAULT(triage_agent.output.hostname, triage_agent.output.target))",
          "wait_seconds": 0,
          "external_case": "=DEFAULT(DEFAULT(alert.body.external_case, alert.external_case), null)"
        },
        "story": "<<STORY.execbound_govern_an_action>>"
