{
  "name": "execbound-console",
  "private": true,
  "version": "0.1.0",
  "license": "AGPL-3.0-only",
  "description": "The ExecBound console: a single-page application served by the gateway at the console's own paths.",
  "type": "module",
  "engines": {
    "node": "24.21.0",
    "pnpm": "11.26.0"
  },
  "scripts": {
    "dev": "pnpm generate && vite",
    "dev:hosted": "pnpm generate:hosted && vite --mode hosted",
    "build": "pnpm generate && vite build && node scripts/budget.mjs",
    "build:hosted": "pnpm generate:hosted && vite build --mode hosted && node scripts/budget.mjs hosted",
    "typecheck": "pnpm generate && tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "typecheck:hosted": "pnpm generate:hosted && tsc --noEmit -p src/hosted/tsconfig.json",
    "lint": "eslint . --ignore-pattern \"src/hosted/**\"",
    "lint:hosted": "pnpm generate:hosted && eslint src/hosted",
    "test": "pnpm generate && vitest run",
    "test:hosted": "pnpm generate:hosted && vitest run --mode hosted",
    "check": "pnpm typecheck && pnpm lint && pnpm test && pnpm build",
    "check:hosted": "pnpm typecheck:hosted && pnpm lint:hosted && pnpm test:hosted && pnpm build:hosted",
    "generate": "openapi-ts",
    "generate:hosted": "pnpm generate && openapi-ts -f src/hosted/openapi-ts.config.ts"
  },
  "dependencies": {
    "@base-ui/react": "1.8.0",
    "@tanstack/react-query": "5.104.1",
    "@tanstack/react-router": "1.170.41",
    "cmdk": "1.1.1",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@hey-api/openapi-ts": "0.99.0",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/router-plugin": "1.168.42",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "24.19.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "axe-core": "4.13.0",
    "eslint": "10.12.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "jsdom": "30.1.1",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "vite": "8.3.2",
    "vitest": "5.0.3"
  },
  "packageManager": "pnpm@11.26.0+sha512.fc0e2bf890b9f983611f1ab68c0637bce914390653699f83c1a78b005ed25f2c81e77920c8fd8eee2ecf0b58b28cdcb00a84d97f69bcf7c56b2f344710238664"
}
